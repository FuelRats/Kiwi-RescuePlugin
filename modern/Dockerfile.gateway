# syntax=docker/dockerfile:1.7
#
# kiwiirc/webircgateway pinned to one commit, built with a current Go toolchain and with its
# direct dependencies lifted to fixed releases (upstream's go.mod pins 2023 x/net, x/crypto and
# jwt v4.5.0, all with published CVEs). Static binary on distroless, runs as nonroot.
# The config is bind-mounted at /etc/webircgateway/config.conf (see gateway/*.conf); secrets come
# from the environment through the config's $VAR values (patches-gateway/).
#
#   docker build -f modern/Dockerfile.gateway -t fr-kiwi-gateway modern/

ARG GO_IMAGE=golang:1.27-alpine
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot

FROM ${GO_IMAGE} AS build
ARG WEBIRCGATEWAY_COMMIT=be9fd5be5d995184d61fac64fc1742ceca25e05f
ADD --checksum=sha256:d240dc965d8c3700e9c2b2064d3b040b88ccadf454f99230b1de9c01ddce3800 \
    https://github.com/kiwiirc/webircgateway/archive/${WEBIRCGATEWAY_COMMIT}.tar.gz /tmp/wig.tar.gz
WORKDIR /src
RUN apk add --no-cache git && tar -xzf /tmp/wig.tar.gz --strip-components=1
# Lets `secret` and `webirc` take $ENV_VAR values like the other keys, so no secret lives in the
# bind-mounted config file.
COPY patches-gateway/ /tmp/patches/
RUN git apply -p1 /tmp/patches/*.patch
RUN go get \
        golang.org/x/net@v0.62.0 \
        golang.org/x/crypto@v0.58.0 \
        golang.org/x/time@v0.16.0 \
        github.com/golang-jwt/jwt/v4@v4.5.2 \
        github.com/gorilla/websocket@v1.5.3 \
        github.com/igm/sockjs-go/v3@v3.0.3 && \
    go mod tidy && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/webircgateway . && \
    /out/webircgateway --version

FROM ${RUNTIME_IMAGE}
LABEL org.opencontainers.image.title="fr-kiwi-gateway" \
      org.opencontainers.image.description="kiwiirc webircgateway for the FuelRats rescue client" \
      org.opencontainers.image.source="https://github.com/FuelRats/Kiwi-RescuePlugin"
COPY --from=build /out/webircgateway /usr/local/bin/webircgateway
USER nonroot
EXPOSE 7001
ENTRYPOINT ["/usr/local/bin/webircgateway", "--config=/etc/webircgateway/config.conf"]
