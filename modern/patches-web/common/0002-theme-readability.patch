+   from the regular-weight italic join, part and quit lines */
 .kiwi-messagelist-message-action .kiwi-messagelist-body {
-    color: var(--brand-primary);
+    color: var(--brand-action-fg, var(--brand-primary));
+    font-style: italic;
+    font-weight: 600;
 }
 
